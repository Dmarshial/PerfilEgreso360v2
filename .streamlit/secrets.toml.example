# Copia este archivo como .streamlit/secrets.toml y completa los valores.
# NUNCA subas secrets.toml al repositorio (ya está en .gitignore).
# En Streamlit Community Cloud: pega este mismo contenido en
# Manage app → Settings → Secrets.

# --------------------------------------------------------------------------
# 1) Proveedor de identidad (Google)
# --------------------------------------------------------------------------
[auth]
# Local:  http://localhost:8501/oauth2callback
# Nube:   https://TU-APP.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Cadena aleatoria larga. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "CAMBIA-ESTO-POR-UNA-CADENA-ALEATORIA-LARGA"

client_id = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxxxxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --------------------------------------------------------------------------
# 2) Autorización (quién puede entrar, una vez identificado por Google)
# --------------------------------------------------------------------------
[acceso]
# Cualquier cuenta de estos dominios entra directo.
dominios_permitidos = ["usek.cl", "uisek.cl"]

# Excepciones puntuales fuera del dominio (pares evaluadores, CNA, etc.).
correos_permitidos = []

# Solo para desarrollo local sin credenciales OAuth. Debe ser false en la nube.
permitir_sin_login = false

# Etiqueta de rol que se muestra en la barra lateral.
[acceso.roles]
"diego.marcial@usek.cl" = "Administrador"
